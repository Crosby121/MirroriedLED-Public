{
  "manifest_version": 3,
  "name": "Mirroried LED AI Capture",
  "version": "0.1.0",
  "description": "Checkpoint explicitly tracked Mirroried LED browser chats to the private local retry queue.",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "alarms", "nativeMessaging", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "https://agent.hostinger.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Mirroried LED AI capture status"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://agent.hostinger.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
